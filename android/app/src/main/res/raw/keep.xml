<?xml version="1.0" encoding="utf-8"?>
<!-- Notification icons are referenced by name at runtime ("@mipmap/ic_launcher"), so resource
     shrinking can't see they're used. Without this, release-build notifications fail silently. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@mipmap/ic_launcher,@drawable/*" />
